---
const id = `poke-slot-${Math.random().toString(16).slice(2)}`;
const base = import.meta.env.BASE_URL;
const asset = (p: string) => `${String(base).replace(/\/$/, '')}/${String(p).replace(/^\//, '')}`;
---

<section class="section" aria-label="Poke Slot">
  <div class="sectionTitle">
    <h2>POKE SLOT</h2>
    <span class="hint">像素老虎机（轻量 · 点击拉杆开转）</span>
  </div>

  <div class="slot" data-pokeslot id={id} style={`--base: ${String(base).replace(/\/$/, '')}/`}>
    <div class="machine" role="group" aria-label="宠物小精灵老虎机">
      <div class="marquee" aria-hidden="true">
        <div class="score">SCORE<br /><span data-score>0020</span></div>
        <div class="score">WIN<br /><span data-win>0000</span></div>
      </div>

      <div class="cabinet">
        <canvas class="fx" data-fx aria-hidden="true"></canvas>
        <div class="jackpotBanner" aria-hidden="true">欧皇降临</div>

        <div class="sideScale left" aria-hidden="true">
          <span class="badge b3">3</span>
          <span class="badge b2">2</span>
          <span class="badge b1">1</span>
          <span class="badge b2">2</span>
          <span class="badge b3">3</span>
        </div>
        <div class="sideScale right" aria-hidden="true">
          <span class="badge b3">3</span>
          <span class="badge b2">2</span>
          <span class="badge b1">1</span>
          <span class="badge b2">2</span>
          <span class="badge b3">3</span>
        </div>
        <div class="reels" aria-hidden="true">
          <div class="reel" data-reel="0"><div class="reelWindow"><div class="reelStrip"></div></div></div>
          <div class="reel" data-reel="1"><div class="reelWindow"><div class="reelStrip"></div></div></div>
          <div class="reel" data-reel="2"><div class="reelWindow"><div class="reelStrip"></div></div></div>
        </div>

        <button class="lever" data-lever type="button" aria-label="拉杆">
          <div class="leverRod" aria-hidden="true"></div>
          <div class="leverKnob" aria-hidden="true"></div>
        </button>

        <div class="controls">
          <div class="slotButtons" aria-hidden="true">
            <span class="btnDot"></span>
            <span class="btnDot"></span>
            <span class="btnDot"></span>
          </div>
          <div class="slotResult" data-result aria-live="polite"></div>
        </div>
      </div>

      <div class="lights" aria-hidden="true">
        <span class="lamp"></span><span class="lamp"></span><span class="lamp"></span>
        <span class="lamp"></span><span class="lamp"></span><span class="lamp"></span>
      </div>

      <script type="module" define:vars={{ id, base }}>
        const root = document.getElementById(id);
        if (!root) {
          console.warn('pokeslot: root not found', id);
        } else {

        const ITEMS = [
          { name: '皮卡丘', slug: 'pikachu' },
          { name: '伊布', slug: 'eevee' },
          { name: '可达鸭', slug: 'psyduck' },
          { name: '妙蛙种子', slug: 'bulbasaur' },
          { name: '小火龙', slug: 'charmander' },
          { name: '杰尼龟', slug: 'squirtle' },
          { name: '胖丁', slug: 'jigglypuff' },
          { name: '喵喵', slug: 'meowth' },
          { name: '卡比兽', slug: 'snorlax' },
          { name: '耿鬼', slug: 'gengar' },
          { name: '鲤鱼王', slug: 'magikarp' },
          { name: '超梦', slug: 'mewtwo' },
        ];

        const itemH = parseFloat(getComputedStyle(root).getPropertyValue('--symbolH')) || 128;
        const iconSize = parseFloat(getComputedStyle(root).getPropertyValue('--iconSize')) || itemH;

        const reels = Array.from(root.querySelectorAll('[data-reel]'));
        const lever = root.querySelector('[data-lever]');
        const result = root.querySelector('[data-result]');
        const scoreEl = root.querySelector('[data-score]');
        const winEl = root.querySelector('[data-win]');
        const fx = root.querySelector('[data-fx]');

        const reducedMotion = typeof window !== 'undefined' && window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const celebrate = (accentSlug) => {
          try {
            root.classList.add('isCelebrate');

            if (reducedMotion || !fx) return;
            const ctx = fx.getContext('2d');
            if (!ctx) return;

            const r = fx.getBoundingClientRect();
            const dpr = Math.min(3, window.devicePixelRatio || 1);
            fx.width = Math.max(1, Math.floor(r.width * dpr));
            fx.height = Math.max(1, Math.floor(r.height * dpr));
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

            const W = r.width;
            const H = r.height;
            const cx = W * 0.52;
            const cy = H * 0.46;

            const palette = {
              gold: '#F2B705',
              ember: '#E97D4A',
              mint: '#8CF0B4',
              sky: '#78D2FF',
              white: 'rgba(255,255,255,.92)',
            };
            // slight variation per icon
            const accent = accentSlug === 'gengar' ? '#9B7BFF'
              : accentSlug === 'mewtwo' ? '#B6A2FF'
              : accentSlug === 'pikachu' ? '#FFD34D'
              : palette.gold;

            const particles = [];
            const burstN = 56;
            for (let i = 0; i < burstN; i++) {
              const a = (Math.PI * 2 * i) / burstN + (Math.random() - 0.5) * 0.18;
              const sp = 2.6 + Math.random() * 4.2;
              particles.push({
                x: cx,
                y: cy,
                vx: Math.cos(a) * sp,
                vy: Math.sin(a) * sp,
                g: 0.12 + Math.random() * 0.10,
                r: 2 + Math.random() * 3,
                life: 780 + Math.random() * 320,
                t: 0,
                c: i % 5 === 0 ? accent : (i % 3 === 0 ? palette.ember : palette.gold),
              });
            }

            const t0 = performance.now();
            const DUR = 1100;
            const draw = (now) => {
              const t = now - t0;
              ctx.clearRect(0, 0, W, H);

              // glow rings
              const p = Math.min(1, t / DUR);
              for (let k = 0; k < 2; k++) {
                const rr = 20 + (k * 18) + p * (130 + k * 40);
                ctx.globalAlpha = (1 - p) * (k === 0 ? 0.55 : 0.28);
                ctx.strokeStyle = k === 0 ? accent : palette.gold;
                ctx.lineWidth = k === 0 ? 6 : 3;
                ctx.beginPath();
                ctx.arc(cx, cy, rr, 0, Math.PI * 2);
                ctx.stroke();
              }

              // star burst lines
              ctx.globalAlpha = Math.max(0, 0.55 - p * 0.4);
              ctx.strokeStyle = palette.white;
              ctx.lineWidth = 2;
              for (let i = 0; i < 16; i++) {
                const a = (Math.PI * 2 * i) / 16;
                const len = 36 + p * 120;
                ctx.beginPath();
                ctx.moveTo(cx + Math.cos(a) * 18, cy + Math.sin(a) * 18);
                ctx.lineTo(cx + Math.cos(a) * len, cy + Math.sin(a) * len);
                ctx.stroke();
              }

              // particles
              for (const pt of particles) {
                pt.t += 16.6;
                const alive = pt.t < pt.life;
                if (!alive) continue;
                pt.vy += pt.g;
                pt.x += pt.vx;
                pt.y += pt.vy;
                const alpha = Math.max(0, 1 - pt.t / pt.life);
                ctx.globalAlpha = alpha;
                ctx.fillStyle = pt.c;
                ctx.beginPath();
                if (ctx.roundRect) {
                  ctx.roundRect(pt.x, pt.y, pt.r * 1.2, pt.r * 2.6, 2);
                } else {
                  ctx.rect(pt.x, pt.y, pt.r * 1.2, pt.r * 2.6);
                }
                ctx.fill();
              }

              if (t < DUR) {
                requestAnimationFrame(draw);
              } else {
                ctx.clearRect(0, 0, W, H);
              }
            };
            requestAnimationFrame(draw);
          } catch (_) {
            // ignore
          }
        };

        // --- Scoring (slot-like) ---
        // CREDIT (SCORE): starts at 20, each spin costs 1.
        // WIN: shows "this spin" payout only.
        const pad4 = (n) => String(Math.max(0, n | 0)).padStart(4, '0');

        let credit = 20;
        let winThis = 0;

        const setLeverEnabled = (enabled) => {
          if (!lever) return;
          lever.toggleAttribute('disabled', !enabled);
        };

        const renderScore = () => {
          if (scoreEl) scoreEl.textContent = pad4(credit);
          if (winEl) winEl.textContent = pad4(winThis);
          setLeverEnabled(credit > 0);
        };

        renderScore();

        // Preload & decode icons to prevent end-of-spin jank.
        const basePath = (root.style.getPropertyValue('--base') || '/').trim();
        const iconUrls = ITEMS.map((it) => `${basePath}assets/pokeslot-icons/${it.slug}.png`);
        setLeverEnabled(false);
        Promise.all(
          iconUrls.map((u) => {
            const img = new Image();
            img.decoding = 'async';
            img.loading = 'eager';
            img.src = u;
            // decode() isn't supported everywhere; fallback to onload.
            return (img.decode ? img.decode().catch(() => undefined) : new Promise((res) => (img.onload = () => res(undefined))));
          })
        )
          .catch(() => undefined)
          .finally(() => {
            setLeverEnabled(credit > 0);
          });

        const setCell = (el, idx) => {
          const it = ITEMS[idx];
          const url = `${basePath}assets/pokeslot-icons/${it.slug}.png`;
          // Inline styles so dynamically-created cells always render.
          el.style.backgroundImage = `url(${url})`;
          el.style.backgroundRepeat = 'no-repeat';
          el.style.backgroundPosition = 'center';
          el.style.backgroundSize = `${iconSize}px ${iconSize}px`;
          el.style.imageRendering = 'pixelated';
          el.style.filter = 'none';
          el.setAttribute('aria-label', it.name);
        };

        const STRIP_CYCLES = 8;
        const BASE_CYCLE = 3;

        const buildStrip = (strip) => {
          strip.innerHTML = '';
          for (let c = 0; c < STRIP_CYCLES; c++) {
            for (let i = 0; i < ITEMS.length; i++) {
              const cell = document.createElement('div');
              cell.className = 'reelCell';
              setCell(cell, i);
              strip.appendChild(cell);
            }
          }
        };

        const setOffset = (strip, px, animate) => {
          strip.style.transitionDuration = animate ? '780ms' : '0ms';
          strip.style.transform = `translate3d(0, ${-px}px, 0)`;
        };

        // init strips (randomize initial visible symbols)
        const cycleH = ITEMS.length * itemH;
        const offsets = new Array(reels.length).fill(0);

        for (let r = 0; r < reels.length; r++) {
          const strip = reels[r].querySelector('.reelStrip');
          if (!strip) continue;
          buildStrip(strip);

          // Make the chosen symbol land in the MIDDLE row.
          const init = Math.floor(Math.random() * ITEMS.length);
          offsets[r] = BASE_CYCLE * cycleH + init * itemH - itemH;
          setOffset(strip, offsets[r], false);
        }

        let busy = false;

        // 20% win chance: force a middle-line three-of-a-kind.
        const WIN_PROB = 0.20;
        const PAYOUT = 5; // credit payout on win

        const randIdx = () => Math.floor(Math.random() * ITEMS.length);

        const genFinal = () => {
          if (Math.random() < WIN_PROB) {
            const i = randIdx();
            return [i, i, i];
          }
          // non-win: ensure not all equal
          let a = randIdx(), b = randIdx(), c = randIdx();
          if (a === b && b === c) c = (c + 1) % ITEMS.length;
          return [a, b, c];
        };

        const sleep = (ms) => new Promise((res) => setTimeout(res, ms));

        const spin = async () => {
          if (busy) return;
          if (credit <= 0) {
            if (result) result.textContent = '筹码不足（SCORE=0）';
            renderScore();
            return;
          }

          busy = true;
          root.classList.add('isSpinning');
          if (result) result.textContent = '';

          // pay cost
          credit -= 1;
          winThis = 0;
          renderScore();

          const final = genFinal();

          const mod = (n) => ((n % cycleH) + cycleH) % cycleH;
          const endModFor = (idx) => mod(idx * itemH - itemH); // middle row

          for (let r = 0; r < reels.length; r++) {
            const strip = reels[r].querySelector('.reelStrip');
            if (!strip) continue;

            // Animate from current offset to target offset (always forward).
            const cur = offsets[r] || (BASE_CYCLE * cycleH);
            const curMod = mod(cur);
            const endMod = endModFor(final[r]);
            const delta = (endMod - curMod + cycleH) % cycleH;

            const extraTurns = 2 + r; // stagger
            const target = cur + extraTurns * cycleH + delta;

            setOffset(strip, target, true);
            offsets[r] = target;
            await sleep(170);
          }

          await sleep(980);

          // Normalize offsets back into the strip range (no visual jump because symbols repeat every cycle).
          for (let r = 0; r < reels.length; r++) {
            const strip = reels[r].querySelector('.reelStrip');
            if (!strip) continue;
            offsets[r] = BASE_CYCLE * cycleH + mod(offsets[r]);
            setOffset(strip, offsets[r], false);
          }

          root.classList.remove('isSpinning');

          // Derive the final (middle-line) symbols from the DOM to avoid rare mobile desync
          // between the planned `final` and the actually rendered stop position.
          const parseTranslateY = (t) => {
            if (!t || t === 'none') return 0;
            const m2d = t.match(/^matrix\(([^)]+)\)$/);
            if (m2d) {
              const parts = m2d[1].split(',').map((s) => parseFloat(s.trim()));
              return parts[5] || 0;
            }
            const m3d = t.match(/^matrix3d\(([^)]+)\)$/);
            if (m3d) {
              const parts = m3d[1].split(',').map((s) => parseFloat(s.trim()));
              return parts[13] || 0;
            }
            return 0;
          };

          const slugFromBg = (bg) => {
            const m = String(bg || '').match(/pokeslot-icons\/(.*?)(?:\.(png|webp|jpg|jpeg)|[\)\"\'])/);
            return m ? m[1] : null;
          };

          const midCenter = itemH * 1.5;
          const middleSlugs = reels.map((reel) => {
            const strip = reel.querySelector('.reelStrip');
            if (!strip) return null;
            const ty = parseTranslateY(getComputedStyle(strip).transform);
            const k = Math.floor((midCenter - ty) / itemH);
            const cell = strip.children[k];
            return cell ? slugFromBg(getComputedStyle(cell).backgroundImage) : null;
          });

          const middleNames = middleSlugs.map((slug) => ITEMS.find((it) => it.slug === slug)?.name || slug || '');
          const jackpot = !!middleSlugs[0] && middleSlugs.every((s) => s === middleSlugs[0]);

          if (jackpot) {
            winThis = PAYOUT;
            credit += winThis;
          } else {
            winThis = 0;
          }
          renderScore();

          if (result) result.textContent = jackpot
            ? `命中！${middleNames[0]} 三连 +${winThis}`
            : `结果：${middleNames[0]} / ${middleNames[1]} / ${middleNames[2]}（未中奖）`;

          if (jackpot) {
            root.classList.add('isJackpot');
            celebrate(middleSlugs[0]);
            await sleep(1200);
            root.classList.remove('isJackpot');
            root.classList.remove('isCelebrate');
          } else {
            root.classList.remove('isJackpot');
            root.classList.remove('isCelebrate');
          }

          busy = false;
        };

        lever?.addEventListener('click', spin);
      }
      </script>
    </div>
  </div>
</section>

<style>
  /* Entire machine is self-contained so styles always apply */
  .slot{margin-top:4px; --symbolH: 128px; --iconSize: 128px;}

  .machine{
    position:relative;
    padding:18px 18px 16px;
    border-radius:22px;
    border:1px solid rgba(0,0,0,.12);
    background:
      linear-gradient(180deg, rgba(255,255,255,.55), rgba(255,255,255,.25)),
      radial-gradient(1200px 480px at 50% 0%, rgba(242,183,5,.18), transparent 60%),
      linear-gradient(180deg, rgba(249,186,56,.55), rgba(233,125,74,.22));
    box-shadow:0 18px 55px rgba(0,0,0,.08);
    overflow:hidden;
    max-width:720px;
    margin:0 auto;
  }

  /* pixel-ish bezel */
  .cabinet{
    position:relative;
    border-radius:20px;
    border:1px solid rgba(0,0,0,.14);
    background:
      linear-gradient(180deg, rgba(247,170,36,.52), rgba(245,132,66,.20));
    box-shadow: inset 0 1px 0 rgba(255,255,255,.45);
    padding:14px 14px 12px;
  }

  /* Celebration FX */
  .fx{position:absolute; inset:0; width:100%; height:100%; pointer-events:none; opacity:0; transition: opacity .14s ease; mix-blend-mode: screen;}
  .slot.isCelebrate .fx{opacity:1}

  .jackpotBanner{
    position:absolute;
    left:50%;
    top:10px;
    transform: translateX(-50%) scale(.98);
    padding:6px 12px;
    border-radius:999px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-weight:900;
    letter-spacing:.18em;
    font-size:12px;
    color:rgba(255,255,255,.92);
    border:1px solid rgba(255,255,255,.16);
    background:
      radial-gradient(120px 60px at 30% 30%, rgba(255,255,255,.28), transparent 62%),
      linear-gradient(90deg, rgba(110,90,255,.72), rgba(242,183,5,.82), rgba(233,125,74,.72));
    box-shadow:0 16px 34px rgba(0,0,0,.18);
    text-shadow:0 2px 12px rgba(0,0,0,.35);
    opacity:0;
    pointer-events:none;
    z-index:4;
  }
  .slot.isCelebrate .jackpotBanner{opacity:1; animation: bannerPop 1.15s cubic-bezier(.16,.84,.18,1) both}

  .slot.isCelebrate .cabinet{
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.45),
      0 0 0 3px rgba(242,183,5,.20),
      0 0 0 10px rgba(110,90,255,.10);
  }
  .slot.isCelebrate .reelWindow{border-color: rgba(110,90,255,.55)}

  .slot.isCelebrate .machine{animation: shake .18s ease-in-out 0s 4;}
  @keyframes shake{0%{transform:translate3d(0,0,0)}25%{transform:translate3d(-2px,1px,0)}50%{transform:translate3d(2px,-1px,0)}75%{transform:translate3d(-1px,-2px,0)}100%{transform:translate3d(0,0,0)}}
  @keyframes bannerPop{0%{transform:translateX(-50%) scale(.82); filter: blur(1px); opacity:0}
    22%{transform:translateX(-50%) scale(1.08); filter: blur(0); opacity:1}
    100%{transform:translateX(-50%) scale(1); opacity:1}}


  .marquee{
    display:flex;
    justify-content:center;
    gap:12px;
    margin:2px 0 10px;
  }
  .score{
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    text-align:center;
    padding:8px 10px;
    border-radius:14px;
    background:rgba(0,0,0,.55);
    color:rgba(255,255,255,.9);
    border:1px solid rgba(255,255,255,.10);
    line-height:1.05;
    font-size:12px;
    letter-spacing:.08em;
    min-width:92px;
  }
  .score span{display:block;margin-top:6px;font-size:18px;letter-spacing:.12em}

  .reels{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:10px 68px 10px 68px}

  .reelWindow{
    height: calc(var(--symbolH) * 3);
    border-radius:16px;
    border:1px solid rgba(0,0,0,.18);
    background:
      radial-gradient(220px 120px at 50% 30%, rgba(242,183,5,.14), transparent 70%),
      linear-gradient(180deg, rgba(255,255,255,.96), rgba(255,255,255,.72));
    box-shadow: inset 0 12px 22px rgba(0,0,0,.06);
    overflow:hidden;
    position:relative;
  }
  .reelWindow::before{
    content:"";
    position:absolute;inset:0;pointer-events:none;
    background:
      linear-gradient(180deg, rgba(242,183,5,.14), transparent 32%),
      linear-gradient(0deg, rgba(233,125,74,.10), transparent 40%),
      linear-gradient(180deg, transparent 40%, rgba(0,0,0,.06) 50%, transparent 60%);
    opacity:1;
  }

  /* Softer, cheaper depth: shadow only on the window, not on every symbol */
  .reelWindow{filter: drop-shadow(0 10px 22px rgba(0,0,0,.08))}

  .reelStrip{
    position:absolute;
    left:0; top:0;
    width:100%;
    transform: translate3d(0, 0, 0);
    transition-property: transform;
    transition-timing-function: cubic-bezier(.16,.84,.18,1);
    will-change: transform;
  }

  /* Each cell is a symbol slot */
  .slot :global(.reelCell){
    height: var(--symbolH);
    display:flex;
    align-items:center;
    justify-content:center;
    /* subtle in-cell paper wash so icons feel embedded */
    background:
      radial-gradient(38px 20px at 50% 45%, rgba(0,0,0,.05), transparent 70%),
      radial-gradient(70px 40px at 50% 50%, rgba(255,255,255,.55), transparent 62%);
  }

  .controls{margin-top:12px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;min-height:32px}
  .slotButtons{display:flex;gap:10px}
  .btnDot{width:18px;height:18px;border-radius:50%;border:1px solid rgba(0,0,0,.16);
    background: radial-gradient(circle at 30% 30%, rgba(255,255,255,.95), rgba(255,255,255,.12)),
      radial-gradient(circle at 60% 60%, rgba(242,183,5,.95), rgba(233,125,74,.55));
    box-shadow:0 10px 18px rgba(0,0,0,.10);
  }
  .slotResult{color:rgba(0,0,0,.64);font-size:13px;line-height:1.6}

  /* Lever */
  .lever{position:absolute;right:-10px;top:96px;width:58px;height:140px;display:flex;align-items:flex-start;justify-content:center;
    background:transparent;border:none;padding:0;cursor:pointer; z-index:3;}
  .lever:focus-visible{outline:none;box-shadow:0 0 0 4px rgba(242,183,5,.18);border-radius:16px}
  .lever[disabled]{opacity:.45; cursor:not-allowed}
  .leverRod{width:12px;height:92px;border-radius:999px;background:rgba(0,0,0,.14);border:1px solid rgba(0,0,0,.10);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.5);
    transform-origin: top center;
    transition: transform .18s ease;
  }
  .leverKnob{margin-top:-14px;width:34px;height:34px;border-radius:50%;
    background: radial-gradient(circle at 30% 30%, rgba(255,255,255,.96), rgba(255,255,255,.25)),
      radial-gradient(circle at 55% 55%, rgba(242,183,5,.92), rgba(233,125,74,.55));
    border:1px solid rgba(0,0,0,.12);
    box-shadow:0 10px 18px rgba(0,0,0,.10);
    transform-origin: top center;
    transition: transform .18s ease;
  }

  .slot.isSpinning .reelWindow{border-color: rgba(233,125,74,.45)}
  .slot.isSpinning .leverRod{transform: rotate(16deg) translateY(6px)}
  .slot.isSpinning .leverKnob{transform: translateY(12px)}

  .slot.isJackpot .reelWindow{border-color: rgba(242,183,5,.82); box-shadow: 0 0 0 4px rgba(242,183,5,.12) inset, inset 0 10px 18px rgba(0,0,0,.06);}
